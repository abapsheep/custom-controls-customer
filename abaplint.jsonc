{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      // the abap2UI5 framework this extension plugs into - cloned by abaplint
      // for dependency resolution (z2ui5_if_app, z2ui5_if_client,
      // z2ui5_cl_ai_xml)
      "url": "https://github.com/abap2UI5/abap2UI5",
      "files": "/src/**/*.*"
    },
    {
      // SAP standard objects abaplint cannot know by itself - here
      // if_serializable_object, which every custom filter/mapper handed to
      // client->_bind( ) has to implement. Same dependency the abap2UI5
      // samples and custom-controls repositories use.
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "^(Z|Y)"
  },
  "rules": {
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_subrc": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "allowed_object_types": {
      // WAPA is the BSP application Z2UI5EXT that carries this repository's
      // frontend artefacts, SICF are the ICF nodes it is served from (both
      // generated from app/webapp by 'npm run app2bsp')
      "allowed": ["CLAS", "DEVC", "INTF", "WAPA", "SICF"]
    },
    "obsolete_statement": true,
    "definitions_top": false,
    "7bit_ascii": true,
    "line_length": {
      "length": 255
    },
    "object_naming": {
      "patternKind": "required",
      // Every object carries the token of this repository:
      // Z2UI5_<type>_CCC<_object> - ccc for "custom control customers", the
      // counterpart of smp in abap2UI5/samples and cc in the community
      // add-on, so no two repositories claim the same token.
      // Length is capped at 25 characters by the leading lookahead. ABAP
      // allows 30, but build_rename (see abap2UI5) replaces the namespace
      // z2ui5 (5 chars) with up to 9, which costs 4 - so 26 is the hard
      // ceiling and 25 keeps one character in reserve. A parallel
      // installation therefore never needs truncation patterns.
      // Change all three patterns together with the object names when you
      // move this repository into your own namespace.
      "clas": "^(?=.{1,25}$)Z2UI5_C(L|X)_CCC",
      "intf": "^(?=.{1,25}$)Z2UI5_IF_CCC"
    }
  }
}
